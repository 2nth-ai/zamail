# Written by Ansible. See .env.example for what each setting means.
ZAMAIL_DOMAINS={{ zamail_domains }}
ZAMAIL_PRIMARY_DOMAIN={{ zamail_primary_domain }}
EDGE_HOSTNAME={{ edge_hostname | default('') }}
EXO_HOST={{ exo_host }}
EXO_TLS_LEVEL=encrypt
STANDBY_HOSTS={{ standby_private_ips | join(' ') }}
TRUSTED_NETS={{ standby_private_ips | map('regex_replace', '$', '/32') | join(' ') }}
QUEUE_LIFETIME=10d
STANDBY_HOSTNAME={{ standby_hostname }}
STANDBY_IMAGE=stalwartlabs/stalwart:v1.1.0
STANDBY_INTAKE_BIND={{ standby_private_ip | default('127.0.0.1') }}
STANDBY_ACME=true
STANDBY_RECOVERY_PASSWORD={{ standby_recovery_password }}
STANDBY_SVC_USER=zamail-svc
STANDBY_SVC_PASSWORD={{ standby_svc_password }}
EDGE_RELAY_HOST={{ edge_relay_host | default('') }}
ZAMAIL_STATE_DIR=/var/lib/zamail
STANDBY_HOST=standby
STANDBY_TLS_VERIFY=false
STANDBY_URL=http://standby:8080
RECIPIENTS_FILE=/etc/zamail/recipients
DIRECTORY_SOURCE=graph
EXO_AUTH=oauth
EXO_IMAP_HOST=outlook.office365.com
EXO_SMTP_HOST={{ exo_host }}
EXO_CANARY_USER={{ exo_canary_user }}
M365_TENANT_ID={{ m365_tenant_id }}
M365_CLIENT_ID={{ m365_client_id }}
M365_CLIENT_SECRET={{ m365_client_secret }}
MIRROR_RECENT_DAYS=3
PROBE_FAIL_THRESHOLD=3
PROBE_OK_THRESHOLD=5
PROBE_NOTIFY_CMD=/zamail/probe/notify-example.sh
WEBMAIL_URL=https://{{ standby_hostname }}
