# ZA Mail settings for one customer instance. Copy to .env on each host and fill in.
# Nothing in this file may be committed once it holds real values.

# --- Customer ---------------------------------------------------------------
ZAMAIL_DOMAINS=corp.co.za                 # space-separated; the first is the primary domain
ZAMAIL_PRIMARY_DOMAIN=corp.co.za

# --- Edge (one per site) ----------------------------------------------------
EDGE_HOSTNAME=mx1.zamail.corp.co.za       # mx2... on the second site
EXO_HOST=corp-co-za.mail.protection.outlook.com
EXO_TLS_LEVEL=encrypt
STANDBY_HOSTS=10.20.0.20 10.30.0.20       # private addresses of the standby node(s)
TRUSTED_NETS=10.20.0.20/32 10.30.0.20/32  # standby nodes allowed to send out through the edge
QUEUE_LIFETIME=10d
EDGE_TLS_DIR=/etc/zamail/tls              # holds fullchain.pem and privkey.pem for EDGE_HOSTNAME

# --- Standby ----------------------------------------------------------------
STANDBY_HOSTNAME=mail.zamail.corp.co.za   # what users type: webmail and IMAP
STANDBY_IMAGE=stalwartlabs/stalwart:v1.1.0
STANDBY_INTAKE_BIND=10.20.0.20            # private address the edge delivers to (never public)
# To publish webmail only (admin console stays private), uncomment both lines:
# COMPOSE_PROFILES=proxy
# STANDBY_HTTPS_BIND=127.0.0.1:8443
STANDBY_ACME=true                         # get a Let's Encrypt certificate for STANDBY_HOSTNAME
STANDBY_RECOVERY_PASSWORD=                # long random; used for setup and by the tools
STANDBY_SVC_USER=zamail-svc
STANDBY_SVC_PASSWORD=                     # long random
EDGE_RELAY_HOST=10.20.0.10                # private address of this site's edge

# --- Tools (provisioner, mirror, probe) -------------------------------------
ZAMAIL_STATE_DIR=/var/lib/zamail
STANDBY_HOST=standby                      # the tools reach the standby over the Docker network
STANDBY_TLS_VERIFY=false                  # that hop uses a private name; Microsoft 365 is always verified
STANDBY_URL=http://standby:8080
RECIPIENTS_FILE=/etc/zamail/recipients
DIRECTORY_SOURCE=graph
EXO_AUTH=oauth
EXO_IMAP_HOST=outlook.office365.com
EXO_SMTP_HOST=corp-co-za.mail.protection.outlook.com
EXO_CANARY_USER=zamail-canary@corp.co.za
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
MIRROR_RECENT_DAYS=3
PROBE_FAIL_THRESHOLD=3
PROBE_OK_THRESHOLD=5
PROBE_NOTIFY_CMD=/zamail/probe/notify-example.sh
WEBMAIL_URL=https://mail.zamail.corp.co.za
