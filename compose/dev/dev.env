# Development settings. These passwords are for the local test stack only.
ZAMAIL_DOMAINS=corp.test
ZAMAIL_STATE_DIR=/var/lib/zamail

# Standby (ZA Mail's own mail server)
STANDBY_HOST=standby
STANDBY_URL=http://standby:8080
STANDBY_HOSTNAME=standby.corp.test
STANDBY_RECOVERY_PASSWORD=dev-recovery-Standby-7391
STANDBY_SVC_USER=zamail-svc
STANDBY_SVC_PASSWORD=dev-svc-Standby-Kettle-4410
STANDBY_ACME=false
EDGE_RELAY_HOST=172.30.53.10
RECIPIENTS_FILE=/etc/zamail/recipients

# Directory source: "file" for development, "graph" for a real Microsoft 365 tenant
DIRECTORY_SOURCE=file
DIRECTORY_FILE=/zamail/compose/dev/directory.json

# "Exchange Online" (in development: the mock-exo container)
EXO_AUTH=master
EXO_IMAP_HOST=mock-exo
EXO_SMTP_HOST=mock-exo
EXO_MASTER_USER=zamail-svc@corp.test
EXO_MASTER_PASSWORD=dev-svc-MockExo-Lantern-9026
EXO_CANARY_USER=alice@corp.test
IMAP_TLS_VERIFY=false
STANDBY_TLS_VERIFY=false

# Mock EXO setup (development only)
MOCK_EXO_URL=http://mock-exo:8080
MOCK_EXO_RECOVERY_PASSWORD=dev-recovery-MockExo-5528
